# Copy to .env and edit. The worker uses a standard (non-scoped) Jira Cloud API token
# with the site-specific https://YOUR_SITE.atlassian.net URL.
JIRA_BASE_URL=https://YOUR_SITE.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=replace-me
JIRA_PROJECT_KEY=AIDEV
REPO_PATH=/absolute/path/to/your/git/repository
GIT_BASE_BRANCH=main
JIRA_READY_STATUS=Ready
JIRA_IN_PROGRESS_STATUS=In Progress
JIRA_REVIEW_STATUS=In Review
JIRA_BLOCKED_STATUS=Blocked
JIRA_READY_LABEL=codex-ready
# REQUIRED: set this to a reliable verification command for your existing repository.
CHECK_COMMAND=flutter pub get && flutter analyze && flutter test
WORKTREE_ROOT=~/.codex-jira-worktrees
CODEX_TIMEOUT_SECONDS=1800
TEST_TIMEOUT_SECONDS=600

# No extra flag required. For automatic initial ticket creation, schedule:
# python3 orchestrator.py tick --bootstrap
# This creates unapproved Jira tickets from project_brief.md/plan.yaml.

# Recovery and quota handling (optional):
# Quota errors pause the affected job and any new Codex work; check every 30 minutes.
QUOTA_RETRY_SECONDS=1800
# Other recoverable failures use capped exponential backoff (120s, 240s, 480s, ...).
RETRY_BASE_SECONDS=120
# After this many consecutive non-quota failures, require manual review.
MAX_RETRIES=3
# Failed CHECK_COMMAND runs can ask the same Codex session to repair tests.
MAX_TEST_REPAIRS=2

# Path to OpenAI Codex CLI; avoids conflicts with other programs named codex.
OPENAI_CODEX_BIN=/opt/homebrew/bin/codex

# Planning status heartbeat (seconds); the live Codex JSONL log is at logs/plan-generation.jsonl
PLAN_HEARTBEAT_SECONDS=15

# OPTIONAL two-agent review loop. Disabled until explicitly enabled.
AUTO_REVIEW_ENABLED=false
# Leave model blank to use the authenticated Codex CLI default.
CODEX_REVIEW_MODEL=
CODEX_REVIEW_EFFORT=medium
CODEX_FIX_MODEL=
CODEX_FIX_EFFORT=medium
# Maximum Agent A fix/push rounds per PR; reviewer can examine each revised head.
MAX_AUTO_REVIEW_FIXES=2
# Additional Agent A test repair attempts per review-fix round (not review rounds)
MAX_REVIEW_TEST_REPAIRS=2
# Poll interval while waiting for CI or a transient review failure.
REVIEW_RETRY_SECONDS=600
# Require green checks for the PR's current head before AI review says passed.
REVIEW_REQUIRE_CI=true
