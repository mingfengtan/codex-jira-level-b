# Copy to .env and edit. The worker uses a standard (non-scoped) Jira Cloud API token
# with the site-specific https://YOUR_SITE.atlassian.net URL.
JIRA_BASE_URL=https://YOUR_SITE.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=replace-me
JIRA_PROJECT_KEY=AIDEV
REPO_PATH=/absolute/path/to/your/git/repository
GIT_BASE_BRANCH=main
JIRA_READY_STATUS=Ready
JIRA_IN_PROGRESS_STATUS=In Progress
JIRA_REVIEW_STATUS=In Review
JIRA_BLOCKED_STATUS=Blocked
JIRA_READY_LABEL=codex-ready
# REQUIRED: set this to a reliable verification command for your existing repository.
CHECK_COMMAND=flutter pub get && flutter analyze && flutter test
WORKTREE_ROOT=~/.codex-jira-worktrees
CODEX_TIMEOUT_SECONDS=1800
TEST_TIMEOUT_SECONDS=600

# No extra flag required. For automatic initial ticket creation, schedule:
# python3 orchestrator.py tick --bootstrap
# This creates unapproved Jira tickets from project_brief.md/plan.yaml.
